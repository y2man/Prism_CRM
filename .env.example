# Backend (local: copy to backend/.env)
DATABASE_URL=sqlite:///./prism.db
FRONTEND_ORIGIN=http://localhost:5173
ENVIRONMENT=development
JWT_SECRET=local-dev-only-change-this-secret-before-deploy
ACCESS_TOKEN_MINUTES=1440
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODELS=llama-3.1-8b-instant,llama-3.3-70b-versatile

# Frontend (local: frontend/.env.local; set to your deployed Render API URL on Vercel)
VITE_API_URL=http://localhost:8000
